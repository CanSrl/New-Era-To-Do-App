# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` git tarafından yok sayılır.
#
# Her iki değişken de boş bırakılabilir: bu durumda uygulama bulut
# senkronizasyonu olmadan, tamamen yerel (LocalStorage) modda çalışır.
#
# Değerleri nereden bulacağınız:
#   - Yerel geliştirme: `npx supabase start` çıktısındaki "API URL" ve "anon key"
#   - Bulut projesi:    Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "GitHub ile devam et" butonunu gösterir. Yalnızca Supabase projesinde
# GitHub sağlayıcısı etkinleştirildiyse `true` yapın; kapalı bir sağlayıcıya
# yönlendirme kullanıcıyı hata sayfasına düşürür. Kurulum adımları için
# README'deki "GitHub ile giriş" bölümüne bakın.
VITE_AUTH_GITHUB=false

# Sentry DSN. Boş bırakılırsa hata izleme kapalıdır: hiçbir ağ isteği
# yapılmaz ve Sentry paketi tarayıcıya indirilmez bile. ErrorBoundary yine
# çalışır, hatalar yalnızca konsola düşer.
# Değeri Sentry'de: Project Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=
