# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` git tarafından yok sayılır.
#
# Her iki değişken de boş bırakılabilir: bu durumda uygulama bulut
# senkronizasyonu olmadan, tamamen yerel (LocalStorage) modda çalışır.
#
# Değerleri nereden bulacağınız:
#   - Yerel geliştirme: `npx supabase start` çıktısındaki "API URL" ve "anon key"
#   - Bulut projesi:    Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
